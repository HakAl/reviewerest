{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed shared candidate finding output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "location",
          "claim",
          "severity"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "unrated"
            ]
          },
          "location": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "start_line",
                "end_line"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
